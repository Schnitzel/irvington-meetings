---
/**
 * One recording (brief §7).
 *
 * The full transcript is rendered here as static HTML. That is what makes the
 * page readable before the audio buffers (§10.3), what makes it work with
 * JavaScript disabled (§9), and what keeps 20,000 words out of the DOM as
 * per-word spans — the player builds those on demand, for one paragraph at a
 * time.
 */
import Base from '../layouts/Base.astro';
import Player from '../components/Player/Player.astro';
import '../styles/transcript.css';
import {
  archiveUrl,
  audioUrl,
  describeDuration,
  formatBytes,
  formatDate,
  formatDuration,
  getMeetings,
  speakerGroupIndex,
  speakerGroups,
  transcriptUrl,
  type Meeting,
} from '../lib/content.ts';

export function getStaticPaths() {
  return getMeetings().map((meeting) => ({
    params: { slug: meeting.slug },
    props: { meeting },
  }));
}

const { meeting } = Astro.props as { meeting: Meeting };
const { meta, transcript } = meeting;

const audio = audioUrl(meeting);
const archive = archiveUrl(meeting);
const jsonUrl = transcriptUrl(meeting.slug);

/*
 * A numbered label claims nothing, but a name is an inference: from the roll
 * call, or from someone introducing themselves. Diarization also merges and
 * splits voices, so even a correct reading of the roll call can end up on the
 * wrong turns. The page therefore presents names as possibilities, never as
 * attributions.
 */
const isNumbered = (name: string) => /^Speaker \d+$/.test(name);

/**
 * Gap totals are often well under a minute, where rounding to minutes reads
 * as "0 minutes in total" — which tells a reader nothing and looks broken.
 */
function describeGapTime(seconds: number): string {
  if (seconds < 90) return `${Math.round(seconds)} seconds`;
  const minutes = Math.round(seconds / 60);
  return `${minutes} minute${minutes === 1 ? '' : 's'} in total`;
}

const groups = speakerGroups(meeting);
const groupOf = speakerGroupIndex(meeting);
const nameOf = new Map(groups.map((g) => [g.id, g.name]));

// A speaker label is only printed when the speaker changes, so a long turn
// reads as prose rather than as a list of attributions. Grouping is applied
// first, so consecutive audience questions do not each get their own
// "Other speaker" heading.
// Gaps are keyed by the paragraph they follow, so the transcript can be
// rendered as one ordered pass.
const gapAfter = new Map((transcript.gaps ?? []).map((g) => [g.start.toFixed(2), g]));

const paragraphs = transcript.paragraphs.map((p, i) => {
  const group = groupOf[p.speaker];
  const name = nameOf.get(group) ?? p.speaker;
  return {
    ...p,
    group,
    name,
    // A number claims nothing; a name is an inference and is hedged as one.
    guess: !isNumbered(name),
    showSpeaker: i === 0 || groupOf[transcript.paragraphs[i - 1].speaker] !== group,
    gap: gapAfter.get(p.end.toFixed(2)) ?? null,
  };
});

const gapCount = transcript.gaps?.length ?? 0;
const gapSeconds = (transcript.gaps ?? []).reduce((sum, g) => sum + (g.end - g.start), 0);

const speakerList = groups.map((g) => ({ id: g.id, name: g.name, guess: !isNumbered(g.name) }));
const anyGuesses = speakerList.some((s) => s.guess);
---

<Base title={meta.title} description={meta.description} wide>
  <div class="wrap wrap--wide">
    <article
      class="recording"
      data-slug={meeting.slug}
      data-transcript={jsonUrl}
      data-duration={transcript.duration}
    >
      <header class="recording__head">
        <p class="recording__body-name">{meta.body}</p>
        <h1 class="recording__title">{meta.title}</h1>
        <p class="recording__facts">
          <time datetime={meta.date}>{formatDate(meta.date)}</time>
          <span aria-hidden="true"> · </span>
          <span>{describeDuration(transcript.duration)}</span>
        </p>
        {meta.presenters && meta.presenters.length > 0 && (
          <p class="recording__presenters">
            Presented by {meta.presenters.join(' and ')}
          </p>
        )}
        {meta.description && <p class="recording__desc">{meta.description}</p>}
      </header>

      {/*
        The one and only audio element. With scripting off it stays a plain
        working <audio controls> (§9); the player adopts it and hides this
        wrapper, so the file is never requested twice.
      */}
      <div class="fallback-player" data-fallback>
        <audio
          data-audio
          controls
          preload="metadata"
          src={audio}
          class="fallback-player__audio"></audio>
        <p class="fallback-player__note">
          Turn on JavaScript for the synchronised transcript, search, and
          shareable timestamps.
        </p>
      </div>

      <Player duration={transcript.duration} />

      <div class="recording__links">
        <a class="download" href={audio} download>
          Download the audio
          {meta.audio.bytes > 0 && <span class="download__size">({formatBytes(meta.audio.bytes)})</span>}
        </a>
        {archive && (
          <a class="recording__link" href={archive} rel="noopener">
            Permanent copy at the Internet Archive
          </a>
        )}
        {meta.packet && (
          <a class="recording__link" href={meta.packet.url} rel="noopener">
            {meta.packet.label}
          </a>
        )}
        {meta.source && (
          <a class="recording__link" href={meta.source.url} rel="noopener">
            {meta.source.label}
          </a>
        )}
      </div>

      <aside class="disclaimer">
        <p>
          <strong>This transcript was generated by a computer</strong> and will
          contain errors — misheard words, wrong speaker labels, and missing
          crosstalk. <strong>The audio recording is the authoritative record.</strong>
          Please listen to the audio before quoting anyone.
        </p>
        <p>
          Speaker names are guesses worked out from the recording, not
          attributions, and may be wrong. This is an independent archive and
          not an official record of this meeting.
        </p>
      </aside>

      <h2 class="transcript__heading" id="transcript">Transcript</h2>

      {anyGuesses && (
        <p class="transcript__speakers-note">
          Names below are <strong>guesses</strong>, worked out from the roll call
          and from people introducing themselves. The recording separates voices
          imperfectly, so a name may be attached to the wrong person, and voices
          we could not identify are simply numbered. Listen to the audio before
          attributing anything to anyone.
        </p>
      )}

      {gapCount > 0 && (
        <p class="transcript__note">
          {gapCount === 1 ? 'One passage' : `${gapCount} passages`}
          ({describeGapTime(gapSeconds)}) could not be transcribed —
          {gapCount === 1 ? ' usually a question' : ' mostly questions'} asked
          away from the microphone.
          {gapCount === 1 ? ' It is' : ' They are'} marked in place so you can
          hear {gapCount === 1 ? 'it' : 'them'} for yourself.
        </p>
      )}

      <div class="transcript" data-transcript-body>
        {paragraphs.map((p) => (
          <div
            class="para"
            data-p={p.id}
            data-start={p.start}
            data-end={p.end}
            data-speaker={p.group}
          >
            {p.showSpeaker && (
              <p class="para__speaker">
                <span
                  class={`speaker-chip speaker-chip--${p.group}${p.guess ? ' speaker-chip--guess' : ''}`}
                  title={p.guess
                    ? 'A guess, from the roll call or from someone introducing themselves. It may be wrong.'
                    : 'This voice could not be identified.'}
                >
                  {p.guess && <span class="speaker-chip__hedge">possibly</span>}
                  {p.name}
                </span>
              </p>
            )}
            <p class="para__body">
              <a class="para__time" href={`#t=${p.start.toFixed(2)}`}>
                {formatDuration(p.start)}
              </a>
              <span class="para__text" data-text>{p.text}</span>
            </p>

            {p.gap && (
              <aside
                class="gap"
                data-gap
                data-gap-start={p.gap.start}
                data-gap-end={p.gap.end}
              >
                <p class="gap__label">
                  <a class="gap__jump" href={`#t=${p.gap.start.toFixed(2)}`}>
                    {formatDuration(p.gap.start)}
                  </a>
                  <span>
                    {Math.round(p.gap.end - p.gap.start)} seconds could not be
                    transcribed. Listen to the recording for this part.
                  </span>
                </p>
                {p.gap.text && (
                  <>
                    <p class="gap__guess">{p.gap.text}</p>
                    <p class="gap__caveat">
                      Rough automatic guess at the words above, from a second
                      attempt on unclear audio. It is often wrong and should
                      not be quoted — the recording is the record.
                    </p>
                  </>
                )}
              </aside>
            )}
          </div>
        ))}
      </div>
    </article>
  </div>

  <script>
    // Deferred by default in Astro, so the transcript above has already
    // painted by the time this runs (§9, §10.3).
    import '../components/Player/player.ts';
  </script>
</Base>
