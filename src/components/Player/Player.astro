---
/**
 * The player (brief §8).
 *
 * All markup is emitted server-side and progressively enhanced. Controls start
 * `disabled` and the script enables them once the transcript has loaded, so a
 * visitor never presses a button that does nothing.
 */
import './player.css';

interface Props {
  duration: number;
}

const { duration } = Astro.props;

const speeds = [0.75, 1, 1.25, 1.5, 1.75, 2];
---

{/*
  There is deliberately no <audio> element here. The page renders exactly one,
  inside the no-JS fallback, and this player adopts it — two elements would
  mean two requests for the same 52 MB file.
*/}
<div class="player" data-player hidden>
  <!-- Timeline: search marks and the progress fill live inside the track. -->
  <div class="player__timeline">
    <div
      class="timeline"
      data-timeline
      role="slider"
      tabindex="0"
      aria-label="Seek through the recording"
      aria-valuemin="0"
      aria-valuemax={Math.round(duration)}
      aria-valuenow="0"
      aria-valuetext="0 seconds"
    >
      <div class="timeline__track">
        <div class="timeline__buffered" data-buffered></div>
        <div class="timeline__fill" data-fill></div>
        <div class="timeline__handle" data-handle></div>
      </div>
    </div>
    {/*
      Search marks sit alongside the slider, not inside it: a role="slider"
      may not contain focusable children. Keyboard users reach the same
      matches through the next/previous buttons, so these stay out of the
      tab order and the marks are announced by the counter instead.
    */}
    <div class="timeline__marks" data-marks aria-hidden="true"></div>
    <div class="timeline__hover" data-hover hidden aria-hidden="true"></div>
  </div>

  <div class="player__row">
    <div class="player__transport">
      <button type="button" class="ctl" data-skip="-15" aria-label="Back 15 seconds" disabled>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M12 5V1L7 6l5 5V7a6 6 0 1 1-6 6H4a8 8 0 1 0 8-8z" fill="currentColor"/>
        </svg>
        <span class="ctl__num">15</span>
      </button>

      <button type="button" class="ctl ctl--play" data-play aria-label="Play" disabled>
        <svg class="ctl__icon-play" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M8 5v14l11-7z" fill="currentColor"/>
        </svg>
        <svg class="ctl__icon-pause" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M6 5h4v14H6zM14 5h4v14h-4z" fill="currentColor"/>
        </svg>
      </button>

      <button type="button" class="ctl" data-skip="15" aria-label="Forward 15 seconds" disabled>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" style="transform: scaleX(-1)">
          <path d="M12 5V1L7 6l5 5V7a6 6 0 1 1-6 6H4a8 8 0 1 0 8-8z" fill="currentColor"/>
        </svg>
        <span class="ctl__num">15</span>
      </button>

      <p class="player__time">
        <span data-current>0:00</span><span class="player__time-sep">/</span><span data-total></span>
      </p>
    </div>

    <div class="player__options">
      <label class="speed">
        <span class="speed__label">Speed</span>
        <select data-speed aria-label="Playback speed">
          {speeds.map((s) => (
            <option value={s} selected={s === 1}>{s}×</option>
          ))}
        </select>
      </label>

      <label class="follow">
        <input type="checkbox" data-follow checked />
        <span>Follow along</span>
      </label>
    </div>
  </div>

  <div class="player__search">
    <div class="search">
      <label class="search__field">
        <span class="visually-hidden">Search this transcript</span>
        <svg class="search__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M10 2a8 8 0 1 0 4.9 14.3l5.4 5.4 1.4-1.4-5.4-5.4A8 8 0 0 0 10 2zm0 2a6 6 0 1 1 0 12 6 6 0 0 1 0-12z" fill="currentColor"/>
        </svg>
        <input
          type="search"
          data-search
          placeholder="Search this transcript"
          autocomplete="off"
          spellcheck="false"
        />
      </label>

      <div class="search__nav" data-search-nav hidden>
        <output class="search__count" data-search-count aria-live="polite"></output>
        <button type="button" class="search__step" data-search-prev aria-label="Previous match">↑</button>
        <button type="button" class="search__step" data-search-next aria-label="Next match">↓</button>
        <button type="button" class="search__clear" data-search-clear aria-label="Clear search">×</button>
      </div>
    </div>
  </div>

</div>

<p class="player__status" data-status role="status" aria-live="polite"></p>
